{
  "name": "nanite-path-tracing",
  "version": "0.1.0",
  "description": "Real-time path tracing for the Nanite-style virtualized geometry pipeline (three.js WebGPU r185, TSL compute).",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core/index.js",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "npx --yes serve -l 8080 .",
    "test": "node --test test/*.test.mjs",
    "gpu-test": "node scripts/gpu-test.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "test:artifact": "node scripts/build-artifact.mjs && node scripts/gpu-test.mjs \"/dist/pathtrace-debugger/preview.html?test=1&nomips=1\""
  },
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "tsl",
    "nanite",
    "path-tracing",
    "ray-tracing",
    "meshlet",
    "virtual-geometry"
  ],
  "license": "MIT",
  "peerDependencies": {
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "three": "0.185.0"
  },
  "dependencies": {
    "nanite": "git+https://github.com/miguelmyers8/Nanite.git#d87bc16c90a88c77f764d52bfe43a0e5b5c5b930"
  }
}
